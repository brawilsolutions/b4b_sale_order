<odoo>

    <!-- Vista Tree -->
    <record id="view_b4b_sale_order_tree" model="ir.ui.view">
        <field name="name">b4b.sale.order.tree</field>
        <field name="model">b4b.sale.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id"/>
                <field name="fecha_pedido_prov"/>
                <field name="cliente" readonly="status == 'done'"/>
                <field name="numero_orden_id" readonly="status == 'done'"/>
                <field name="ciudad" readonly="status == 'done'"/>
                <field name="status" readonly="1"/>
                <field name="sincronizado"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_b4b_sale_order_form" model="ir.ui.view">
        <field name="name">b4b.sale.order.form</field>
        <field name="model">b4b.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <!-- Este campo debe estar antes del header para que funcione el botón -->
                <field name="sincronizado" invisible="1" readonly="1"/>

                <header>
                    <button name="action_create_quotation"
                            string="Crear Cotización"
                            type="object"
                            class="btn btn-primary"
                            invisible="status == 'done'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,send,done"/>
                </header>

                <sheet>
                    <group>
                        <field name="cliente" readonly="status == 'done'"/>
                        <field name="tipo_identificacion_id" readonly="status == 'done'"/>
                        <field name="tipo_identificacion" readonly="status == 'done'"/>
                        <field name="identificacion" readonly="status == 'done'"/>
                        <field name="direccion_cliente" readonly="status == 'done'"/>
                        <field name="telefono_cliente" readonly="status == 'done'"/>
                        <field name="ciudad_id" readonly="status == 'done'"/>
                        <field name="ciudad" readonly="status == 'done'"/> 
                        <field name="departamento_id" readonly="status == 'done'"/>
                        <field name="departamento" readonly="status == 'done'"/>
                        <field name="pais" readonly="status == 'done'"/>
                        <field name="fecha_pedido_prov" readonly="status == 'done'"/>
                        <field name="email" readonly="status == 'done'"/>
                        <field name="numero_orden_id" widget="many2one" readonly="status == 'done'"/>
                        <field name="pedido_prov_id" readonly="status == 'done'"/>
                        <field name="notas_cliente" readonly="status == 'done'"/>
                        <field name="guia" readonly="status == 'done'"/>
                        <field name="status" readonly="status == 'done'"/>
                        <field name="ciudad_2"/>
                    </group>

                    <notebook>
                        <page string="Detalles">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="codigo_item"/>
                                    <field name="nombre_item"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="porcentaje_sl"/>
                                    <field name="desc_asesor"/>
                                    <field name="total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para usar en el menú -->
    <record id="action_b4b_sale_order" model="ir.actions.act_window">
        <field name="name">Órdenes B4B</field>
        <field name="res_model">b4b.sale.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
