<odoo>
    <data noupdate="1">

        <record id="ir_cron_b4b_create_quotations" model="ir.cron">
            <field name="name">B4B - Crear Cotizaciones Automáticamente</field>
            <field name="model_id" ref="b4b_sale_order.model_b4b_sale_order"/>
            <field name="state">code</field>
            <field name="code">
                model.search([('status', '!=', 'done'), ('sincronizado', '=', False)]).action_create_quotation()
            </field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active">True</field>
        </record>

    </data>
</odoo>
